[sub_resource type="GDScript" id="GDScript_lose_ui"]
script/source = "extends Node2D

func _ready():
	var day = GameState.get_day()
	$ColorRect/StatsLabel.text = GameState.get_death_line() + \"\\n\\nYou lasted %d day(s) and gathered %d log(s) of wood.\" % [day, GameState.wood_collected]
	$ColorRect/RestartButton.pressed.connect(_on_restart_pressed)

func _on_restart_pressed():
	GameState.reset()
	get_tree().change_scene_to_file(\"res://scenes/game_level.tscn\")
"

[sub_resource type="GDScript" id="GDScript_0e48y"]
script/source = "extends TileMapLayer

func _ready():
	# Add this tilemap to the \"water\" group
	add_to_group(\"water\")
	
	# Get all used cells (tiles that exist)
	var used_cells = get_used_cells()
	
	# For each water tile, create a collision
	for cell_pos in used_cells:
		var tile_data = get_cell_tile_data(cell_pos)
		if tile_data:
			# This tile exists, we can add collision if needed
			# TileMapLayer handles collision automatically if set up in TileSet
			pass

	print(\"Water layer initialized with \", used_cells.size(), \" tiles\")
"

